{
  "components": {
    "schemas": {
      "ErrorData": {
        "description": "Sanitized error payload used by every API error response.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorData",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Stable v1 error envelope.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorData"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthData": {
        "description": "Typed health payload inside the standard success envelope.",
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "service_version": {
            "title": "Service Version",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service_version",
          "api_version"
        ],
        "title": "HealthData",
        "type": "object"
      },
      "HealthMeta": {
        "properties": {
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id"
        ],
        "title": "HealthMeta",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Full typed health response matching the v1 contract envelope.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthData"
          },
          "meta": {
            "$ref": "#/components/schemas/HealthMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "HealthResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "VacancyPilot Ops Companion",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Returns the companion process version, API version, and status. Public endpoint — no client token required.",
        "operationId": "health_api_v1_health_get",
        "parameters": [
          {
            "description": "Optional caller UUID; generated when absent or invalid.",
            "in": "header",
            "name": "X-VacancyPilot-Request-ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Sanitized unhandled server error"
          }
        },
        "summary": "Companion health check",
        "tags": [
          "health"
        ]
      }
    }
  }
}
